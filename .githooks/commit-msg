#!/usr/bin/env bash
# xquad commit-msg hook.
#
# Validates that commit messages follow Conventional Commits and include
# a DCO sign-off. Rules enforced (from AGENTS.md) live in
# scripts/commit-grammar.sh, shared with the CI-side range validator
# (scripts/check-commit-messages.sh) so the two cannot drift:
#
#   - Subject: <type>[(scope)][!]: <description>
#   - Types: see scripts/commit-grammar.sh's TYPES
#   - Subject max 72 characters, lowercase description start, no trailing period
#   - Signed-off-by trailer present
#
# Install once per clone with:
#
#     make install-hooks
#
# Bypass with `git commit --no-verify` when you must.

set -euo pipefail

MSG_FILE="$1"

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../scripts/commit-grammar.sh
source "${HOOK_DIR}/../scripts/commit-grammar.sh"

subject="$(commit_subject < "${MSG_FILE}")"

if [[ -z "${subject}" ]]; then
    echo "commit-msg: empty commit message." >&2
    exit 1
fi

check_commit_subject "${subject}" || exit 1
check_signed_off < "${MSG_FILE}" || exit 1

exit 0
